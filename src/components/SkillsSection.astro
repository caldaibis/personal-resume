---
import Section from './Section.astro';
import type { Resume } from '../data/schema';

interface Props {
  skills: Resume['skills'];
}

const { skills } = Astro.props;
---

<Section title="Skills">
  <dl class="skills-grid grid gap-x-8 gap-y-3 sm:grid-cols-2">
    {skills.map((skill) => (
      <div class:list={[skill.group === 'Software & Cloud' && 'sm:col-span-2']}>
        <dt class="font-mono text-[11px] font-medium uppercase tracking-wider text-accent">
          {skill.group}
        </dt>
        <dd class="mt-0.5 font-mono text-[11px] leading-relaxed text-ink/80">
          {skill.items.join('  ·  ')}
        </dd>
      </div>
    ))}
  </dl>
</Section>
